{
  "name": "vn-rank",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "start": "vite preview",
    "lint": "eslint src scripts",
    "typecheck": "tsc --noEmit",
    "check": "npm run validate:data && npm run lint && npm run typecheck && npm run build",
    "test": "npm run check",
    "import:top": "node scripts/import-vndb-top.mjs",
    "map:egs": "node scripts/map-egs-ids.mjs --write",
    "update:data": "node scripts/update-rankings.mjs",
    "validate:data": "node scripts/validate-data.mjs",
    "validate:synced-data": "node scripts/validate-data.mjs --require-synced"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@types/node": "22.19.19",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.67.0",
    "vite": "8.2.1"
  },
  "type": "module"
}
